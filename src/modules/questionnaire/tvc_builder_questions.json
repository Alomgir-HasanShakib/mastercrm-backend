    "hasDynamicVariable": false,
    "hasActualField": false
  },
  {
    "id": "TVC_Q5",
    "sn": 5,
    "tag": "field_agent_visit_confirmation",
    "columnName": "field_agent_visit_confirmation",
    "code": "FIELD_AGENT_VISIT_CONFIRMATION",
    "labelEn": "5. Sir/Madam, please also tell us whether the agent who came to you to conduct the survey gave you all the answers of your own free will, or did the agent help or suggest you in any way to answer, or did he ask you to answer in your ear or by speaking softly? (whispering check)",
    "labelGu": "સર/મેડમ, કૃપા કરીને અમને આ પણ જણાવશો કે જે એજન્ટ તમારા પાસે સર્વે કરવા આવ્યો હતો, શું તમે બધા જવાબ પોતાની ઇચ્છાથી આપ્યા હતા, કે એજન્ટે તમને જવાબ આપવા કોઈ રીતે મદદ અથવા સૂચન કર્યું હતું? કે પછી તેમણે કાનમાં કે ધીમા અવાજે જવાબ આપવા કહ્યું હતું?",
    "type": "select",
    "options": [
      {
        "label": "Call Completed & Respondent Confirmed that the Survey was Conducted, but the Agent was telling Answers through Whispering.",
        "value": "Agent Whispered Answers"
      },
      {
        "label": "I gave all the answers myself.",
        "value": "Answered Myself"
      }
    ],
    "ruleType": "CONDITIONAL",
    "ruleDescription": "It will open if Option A ('Survey Conducted') is selected in Q-4.",
    "conditions": [
      {
        "questionId": "TVC_Q4",
        "operator": "equals",
        "value": "Survey Conducted",
        "description": "Opens if option A is selected in Q-4"
