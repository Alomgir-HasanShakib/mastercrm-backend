    "code": "FIELD_AGENT_VISIT",
    "labelEn": "4. Was a survey related to the elections conducted at your location by the Nexastats team, in which you were asked about voting and the elections?",
    "labelGu": "તમારા અહીં Nexa Status ની ટીમ તરફથી ચૂંટણી સંબંધિત કોઈ સર્વે થયો હતો જેમાં તમને મત અને ચૂંટણી વિશે પૂછવામાં આવ્યું હતું?",
    "type": "select",
    "options": [
      {
        "label": "Call Completed & Respondent Confirmed that the Survey was Conducted.",
        "value": "Survey Conducted"
      },
      {
        "label": "Call Completed & Respondent Confirmed that Only Demographic Details were Collected (Name/Caste/Mobile Number).",
        "value": "Only Demographic Details"
      },
      {
        "label": "No",
        "value": "No"
      },
      {
        "label": "Do not remember",
        "value": "Do not remember"
      }
    ],
    "ruleType": "BRANCHING",
    "ruleDescription": "Option A opens Question 5 (Whispering / Conduct Check). Only if Q1 is 'Yes, Responder's Name'.",
    "conditions": [
      {
        "questionId": "TVC_Q1",
        "operator": "equals",
        "value": "Yes, Responder's Name",
