# ==============================================================================
# Master Multi-Vendor CRM - Environment Variables Configuration Template
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=5000
APP_NAME=Master CRM Backend
API_PREFIX=/api/v1
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=true

# Database Configuration (PostgreSQL - Local or Hosted like Neon / Supabase / AWS RDS)
# Option A: Pooled Connection URI (Preferred for Neon Serverless / Supabase Pooler)
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Option B: Discrete Parameters (Local / Docker / Standard RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=master_crm_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT=60000
DB_SSL=false

# Client Data Warehouse (External MySQL/Postgres e_solutions)
CLIENT_DB_HOST=server-esolutions.stelleronix.com
CLIENT_DB_PORT=3306
CLIENT_DB_USER=stelleronix
CLIENT_DB_PASSWORD=At@7003883903stlx
CLIENT_DB_NAME=e_solutions
CLIENT_DB_POOL_MAX=10

# Redis Configuration (BullMQ / Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=master_crm:

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_super_secret_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_super_secret_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# File Upload / Storage
UPLOAD_DESTINATION=uploads/
MAX_FILE_SIZE_MB=25

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Logging
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
LOG_DIR=logs

# Cryptography / Encryption (for sensitive database fields)
DATA_ENCRYPTION_KEY=12345678901234567890123456789012
