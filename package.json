{
  "name": "master-crm-backend",
  "version": "1.0.0",
  "description": "Master Multi-Vendor Survey, Audit & Verification CRM Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "seed:make": "knex seed:make",
    "test:db": "node scripts/testDb.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "crm",
    "survey",
    "audit",
    "verification",
    "multi-vendor",
    "express",
    "knex",
    "postgresql"
  ],
  "author": "Master CRM Team",
  "license": "ISC",
